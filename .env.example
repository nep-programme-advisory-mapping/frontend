# -------------------------------------------------------
# API
# -------------------------------------------------------
# In development, use /api so Vite proxies requests to the backend.
# In production, set this to the full backend URL, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Backend origin for the Vite dev server proxy.
# Only used in development — not needed in production builds.
VITE_API_PROXY_TARGET=http://localhost:8000

# -------------------------------------------------------
# Real-time (Laravel Reverb)
# Must match REVERB_APP_KEY in the backend .env
# -------------------------------------------------------
VITE_REVERB_APP_KEY=

# WebSocket host — defaults to window.location.hostname if not set.
# Set explicitly in production, e.g.: VITE_REVERB_HOST=api.yourdomain.com
VITE_REVERB_HOST=

# WebSocket port — defaults to 80 (ws) / 443 (wss) if not set.
# In development with the default backend config, use 8081.
VITE_REVERB_PORT=8081

# ws or https — defaults to https if not set.
# Use http in local development.
VITE_REVERB_SCHEME=http
